      "app_env": "TRUECRIME_META_APP_FILE",
      "app_file": "~/.truecrime/meta/app.json",
      "state_file": "~/.truecrime/meta/instagram_{language}.json",
      "authorize_url": "https://www.facebook.com/{version}/dialog/oauth",
      "redirect_path": "/api/meta-publishing/oauth/callback",
      "api_public_url": "http://127.0.0.1:8001",
      "ui_base_url": "http://127.0.0.1:3001",
      "state_ttl_seconds": 600,
      "expiry_warning_days": 7,
      "evidence": "Facebook Login web flow (dialog/oauth, oauth/access_token, fb_exchange_token for the 60-day token), /me/permissions and debug_token as documented at developers.facebook.com/docs/facebook-login/guides/access-tokens and /docs/graph-api/reference/user/permissions; not yet exercised against a live Meta app."
