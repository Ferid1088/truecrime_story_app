      "instagram_basic",
      "instagram_content_publish",
      "pages_read_engagement"
    ],
    "token_env": "TRUECRIME_META_ACCESS_TOKEN",
    "token_file": "~/.config/truecrime/meta_access_token",
    "prepared_copy_dir": "meta",
    "request_timeout_s": 60,
    "upload_timeout_s": 600,
    "retry_attempts": 3,
