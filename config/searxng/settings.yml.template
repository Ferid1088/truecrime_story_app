# Native SearXNG settings for the local TrueCrime process runner.
use_default_settings: true

general:
  instance_name: "truecrime-searxng"
  privacypolicy_url: false
  enable_metrics: false

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json

server:
  port: 8085
  bind_address: "127.0.0.1"
  secret_key: "__TRUECRIME_SEARXNG_SECRET__"
  limiter: false
  image_proxy: false
  method: "GET"

engines:
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: duckduckgo
    disabled: false
  - name: brave
    disabled: false
  - name: mojeek
    disabled: false
  - name: wikipedia
    disabled: false
  - name: qwant
    disabled: false

outgoing:
  request_timeout: 15.0
  max_request_timeout: 25.0
  useragent_suffix: "truecrime-research"
  pool_connections: 100
  pool_maxsize: 20
