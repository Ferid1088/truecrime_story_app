{
  "blueprint": {
    "max_open_questions": 3,
    "max_unanswered_questions": 2,
    "max_dense_run": 3,
    "max_beat_words": 230,
    "max_repair_iterations": 1,
    "revise_on_warnings": [
      "too_many_open_questions",
      "beat_too_long",
      "hook_not_at_act_start",
      "chapter_end_not_at_act_end",
      "many_unanswered_questions",
      "dense_run_without_recovery"
    ],
    "max_revision_iterations": 1
  },
  "documentary": {
    "languages": [
      "en",
      "de",
      "fa",
      "ar"
    ],
    "max_redos": 2,
    "min_film_minutes": 45,
    "max_film_minutes": 120,
    "pilot_seconds": 180,
    "speech_wpm": {
      "en": 150,
      "de": 128,
      "fa": 116,
      "ar": 104
    },
    "storage_dir": "data/cases",
    "video_research": true,
    "max_tts_characters_per_job": 0
  },
  "artifacts": {
    "shadow_mode": true
  },
  "documentary_critics": {
    "critics": [
      "automation_feel",
      "attention",
      "visual_accuracy",
      "production"
    ],
    "max_fix_iterations": 1,
    "max_asset_reuse": 3
  },
  "concurrency": {
    "llm": 10,
    "vision": 4,
    "elevenlabs_tts": 4,
    "elevenlabs_sound": 2,
    "asr": 1,
    "render": 2,
    "downloads": 4,
    "jobs": 4,
    "languages": 4
  },
  "host": {
    "enabled": true,
    "time_accounting": "added",
    "min_appearances": 2,
    "max_appearances": 5,
    "min_acts_between": 1,
    "min_gap_seconds": 240,
    "short_film_seconds": 600,
    "short_film_min_gap_seconds": 90,
    "short_film_min_appearances": 3,
    "roles": {
      "opening": {
        "position": "opening",
        "base_seconds": 40,
        "min_seconds": 25,
        "max_seconds": 75,
        "requires_question": true
      },
      "transition": {
        "position": "mid",
        "base_seconds": 18,
        "min_seconds": 10,
        "max_seconds": 35
      },
      "reflection": {
        "position": "mid",
        "base_seconds": 26,
        "min_seconds": 15,
        "max_seconds": 45
      },
      "viewer_question": {
        "position": "mid",
        "base_seconds": 16,
        "min_seconds": 8,
        "max_seconds": 30,
        "requires_question": true
      },
      "outro": {
        "position": "final",
        "base_seconds": 28,
        "min_seconds": 15,
        "max_seconds": 50
      }
    },
    "act_weight_gain": 0.5,
    "position_gain": 0.3,
    "max_appearance_seconds": 90,
    "max_total_seconds": 240,
    "max_total_share": 0.08,
    "final_enabled": true,
    "words_per_minute": {
      "en": 162,
      "de": 151,
      "fa": 146,
      "ar": 140
    },
    "word_tolerance": 0.2,
    "duration_tolerance": 0.1,
    "voice_style": "host_conversational",
    "max_repair_iterations": 2,
    "opening_max_first_sentence_words": 16,
    "language_rules": {
      "en": {
        "address_patterns": [
          "\\byou(?:'re|'ve|'ll|'d)?\\b",
          "\\byour(?:s|self)?\\b"
        ],
        "formal_patterns": [],
        "greeting_patterns": [
          "^\\s*(?:hi|hello|hey|welcome|greetings|good (?:evening|morning|day))\\b"
        ],
        "handover_patterns": [
          "\\b(?:let'?s (?:go|get|start|begin|dive|jump)|now (?:let'?s|to) (?:the|our) (?:story|case)|here'?s the story|the story (?:begins|starts)|so,? (?:let'?s )?(?:begin|start))\\b"
        ],
        "question_marks": [
          "?"
        ],
        "stock_phrases": [
          "\\bwhat do you think\\b",
          "\\bwhat would you do\\b",
          "\\bi noticed\\b",
          "\\bstay tuned\\b",
          "\\bshocking\\b",
          "\\bcase id\\b",
          "\\bwelcome back\\b",
          "\\bin this (?:video|episode)\\b",
          "\\blet'?s dive in\\b",
          "\\bbuckle up\\b",
          "\\bviewers?\\b"
        ]
      },
      "de": {
        "address_patterns": [
          "\\b(?:du|dir|dich|dein\\w*|ihr|euch|eure?\\w*)\\b"
        ],
        "formal_patterns": [
          "\\bIhnen\\b",
          "(?<=[a-zäöüß,;]\\s)Sie\\b",
          "(?<=[a-zäöüß,;]\\s)Ihre[mnrs]?\\b"
        ],
        "greeting_patterns": [
          "^\\s*(?:hallo|hi|hey|willkommen|guten (?:abend|morgen|tag)|liebe[rn]?)\\b"
        ],
        "handover_patterns": [
          "\\b(?:fangen wir an|los geht'?s|(?:die|der) (?:geschichte|fall) (?:beginnt|startet)|(?:dann )?(?:mal )?los|gehen wir (?:in|zu|an) |starten wir)\\b"
        ],
        "question_marks": [
          "?"
        ],
        "stock_phrases": [
          "\\bwas denken sie\\b",
          "\\bwas denkst du\\b",
          "\\bwas würden sie tun\\b",
          "\\bwas würdest du tun\\b",
          "\\bmir ist aufgefallen\\b",
          "\\bschockierend\\b",
          "\\bliebe zuschauer\\b",
          "\\bin diesem video\\b",
          "\\bbleibt dran\\b"
        ]
      },
      "fa": {
        "address_patterns": [
          "(?<!\\w)(?:تو|بهت|برات|ازت|باهات|خودت|ببین|بذار|می‌دونی|میدونی|دیدی|تصور کن|فکر کن|حدس بزن|یادت)(?!\\w)"
        ],
        "formal_patterns": [
          "(?<!\\w)(?:شما|می‌دانید|می‌بینید|ببینید|تصور کنید|فکر کنید|توجه کنید|می‌فرمایید)(?!\\w)"
        ],
        "greeting_patterns": [
          "^\\s*(?:سلام|درود|خوش[ ‌]?آمدید|بینندگان)"
        ],
        "handover_patterns": [
          "(?:بریم سراغ|برو?یم سراغ|شروع کنیم|داستان شروع می‌?شه|بریم به داستان|بریم تو داستان)"
        ],
        "question_marks": [
          "؟",
          "?"
        ],
        "stock_phrases": [
          "نظر شما چیست",
          "شما چه فکر می‌کنید",
          "شما چه می‌کردید",
          "متوجه شدم",
          "تکان‌دهنده",
          "ماجرا به همین جا ختم نشد",
          "آرامش قبل از طوفان",
          "سکوت مرگبار",
          "آنچه بعد رخ داد",
          "شگفت‌زده خواهید شد",
          "بینندگان عزیز",
          "در این ویدیو"
        ]
      },
      "ar": {
        "address_patterns": [
          "(?<!\\w)(?:أنت|أنتَ|أنتِ|تخيّل|تخيل|انتبه|فكّر|فكر|خذ|تعال|انظر|تذكّر|تقدر|تعرف|تتذكر|تعتبر|تشعر|تفهم|ترى|تظن|تحب|تريد|هل تعرف|هل تتذكر)(?!\\w)",
          "(?<!\\w)(?:أمام|مع|عند|إلى|على|عن|من|في)ك(?!\\w)"
        ],
        "formal_patterns": [
          "(?<!\\w)(?:أنتم|حضراتكم|مشاهدينا|سادتي|سيداتي|تخيلوا|فكروا|انتبهوا)(?!\\w)"
        ],
        "greeting_patterns": [
          "^\\s*(?:مرحبا|مرحباً|أهلا|أهلاً|السلام عليكم|مساء الخير|صباح الخير)"
        ],
        "handover_patterns": [
          "(?:لنبدأ|هيا بنا|هيا إلى|لننتقل إلى|تبدأ القصة|هيا نبدأ)"
        ],
        "question_marks": [
          "؟",
          "?"
        ],
        "stock_phrases": [
          "ما رأيكم",
          "ماذا تعتقدون",
          "ماذا كنتم ستفعلون",
          "لاحظت",
          "صادم",
          "مشاهدينا الكرام",
          "في هذا الفيديو"
        ]
      }
    },
    "payoff_min_resolved_loops": 2,
    "max_facts": 80,
    "writer_agents": {
      "en": "host_writer",
      "de": "host_writer",
      "fa": "host_writer_fa_ar",
      "ar": "host_writer_fa_ar"
    },
    "spoiler_name_case_languages": [
      "en"
    ],
