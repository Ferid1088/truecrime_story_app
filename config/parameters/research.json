{
  "follow_up_research": {
    "max_rounds": 1,
    "queries_per_gap": 2
  },
  "research": {
    "provider": "truecrime",
    "dedupe_similarity_threshold": 85,
    "job_timeout_minutes": 45,
    "default_profile": "DEEP_CASE_RESEARCH",
    "min_accept_score": 0.2
  },
  "youtube_data_api": {
    "daily_quota_units": 10000,
    "daily_search_calls": 100,
    "reset_timezone": "America/Los_Angeles",
    "cost_units": {
      "search.list": 1,
      "playlistItems.list": 1,
      "videos.list": 1,
      "channels.list": 1
    },
    "discovery_share_percent": 20,
    "uploads_reserved_percent": 10,
    "cache_expiry_hours": 24,
    "max_videos_per_channel_page": 50,
    "max_video_ids_per_call": 50,
    "clip_margin_seconds": 2.0,
    "max_candidates_per_sentence": 3
  },
  "youtube_research": {
    "languages": [
      "en",
      "de",
      "fa",
      "ar"
    ],
    "max_results_per_language": 8,
    "discovery_provider": "auto",
    "max_queries_per_language": 8,
    "classification_rank_bonus": {
      "official": 0.25,
      "documentary": 0.2,
      "news": 0.1,
      "interview": 0.1,
      "archive": 0.05,
      "analysis": 0.0,
      "creator_narration": -0.05,
      "unknown": 0.0
    },
    "search_results_per_query": 20,
    "stop_after_empty_queries": 2,
    "relevance": {
      "accept_from": 0.5,
      "unrelated_below": 0.25,
      "check_batch_size": 20
    }
  },
  "transcript_ingestion": {
    "preferred_languages": [
      "en",
      "de",
      "fa",
      "ar"
    ],
    "max_transcript_seconds": 10800,
    "max_segments_per_video": 2000,
    "request_timeout_seconds": 20
  },
  "transcript_chunking": {
    "target_tokens": 700,
    "min_tokens": 150,
    "max_tokens": 1000
  },
  "transcript_quality": {
    "max_segment_noise_ratio": 0.15,
    "degraded_garbled_rate": 0.15,
    "max_acceptable_garbled_rate": 0.35,
    "min_punctuation_ratio": 0.2
  },
  "transcript_value": {
    "weights": {
      "unique_claims": 0.3,
      "credible_details": 0.2,
      "human_details": 0.15,
      "scene_details": 0.1,
      "quotes": 0.1,
      "contradictions": 0.1,
      "independence": 0.05
    }
  },
  "claim_clustering": {
    "near_duplicate_threshold": 88,
    "batch_size": 60,
    "min_independent_families_for_verified": 2,
    "verify_batch_size": 30
  },
  "source_independence": {
    "shared_unusual_claim_ratio": 0.6,
    "min_shared_unusual_claims": 3
  },
  "embeddings": {
    "max_attempts": 3,
    "retry_backoff_s": 2.0
  },
  "evidence_selection": {
    "max_facts_per_research_stage": 100,
    "term_min_length": 4,
    "contradiction_min_shared_terms": 3,
    "same_contradiction_ratio": 85
  }
}
