{
  "main_visual_planner": {
    "search": {
      "initial_rounds": 1,
      "extra_rounds_max": 4,
      "min_new_candidates_to_continue": 1
    },
    "shots": {
      "min_seconds": 2.5,
      "max_still_seconds": 20.0,
      "target_shots_per_minute": 8.5
    },
    "coverage": {
      "min_temporal_coverage": 0.98,
      "max_uncovered_gap_seconds": 3.0,
      "max_black_frame_seconds": 0.5,
      "evidence_requirements_need_evidence_roles": true
    },
    "verification": {
      "escalate_conflicts_to_second_verifier": true,
      "transient_failure_retries": 3,
      "approving_statuses": [
        "approved"
      ],
      "never_approving_statuses": [
        "unknown",
        "needs_review",
        "transient_failure"
      ],
      "min_confidence_exact_person": 0.85,
      "min_confidence_other": 0.8,
      "min_quality": 0.35,
      "max_candidates_per_requirement": 12,
      "max_requirements_per_asset": 6,
      "rights_profile": "preview"
    },
    "review": {
      "state_machine": [
        "IMPLEMENTING",
        "PRODUCING",
        "VALIDATING",
        "AWAITING_OWNER_REVIEW",
        "APPROVED",
        "REVISION_REQUIRED",
        "REJECTED"
      ],
      "require_english_first": true
    },
    "call_timeout_s": 150,
    "topup": {
      "max_assets": 500,
      "passes": 1,
      "min_relevance": 0.2
    }
  }
}
