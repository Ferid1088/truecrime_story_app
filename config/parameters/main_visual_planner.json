{
  "main_visual_planner": {
    "search": {
      "initial_rounds": 1,
      "extra_rounds_max": 4,
      "min_new_candidates_to_continue": 1
    },
    "shots": {
      "min_seconds": 2.5,
      "max_still_seconds": 20.0,
      "target_shots_per_minute": 8.5
    },
    "coverage": {
      "min_temporal_coverage": 0.9995,
      "max_uncovered_gap_seconds": 0.04,
      "max_black_frame_seconds": 0.5,
      "evidence_requirements_need_evidence_roles": true
    },
    "verification": {
      "escalate_conflicts_to_second_verifier": true,
      "transient_failure_retries": 3,
      "approving_statuses": [
        "approved"
      ],
      "never_approving_statuses": [
        "unknown",
        "needs_review",
        "transient_failure"
      ],
      "min_confidence_exact_person": 0.85,
      "min_confidence_other": 0.8,
      "min_quality": 0.35,
      "max_candidates_per_requirement": 12,
      "max_requirements_per_asset": 6,
      "rights_profile": "preview"
    },
    "review": {
      "state_machine": [
        "IMPLEMENTING",
        "PRODUCING",
        "VALIDATING",
        "AWAITING_OWNER_REVIEW",
        "APPROVED",
        "REVISION_REQUIRED",
        "REJECTED"
      ],
      "require_english_first": true
    },
    "call_timeout_s": 150,
    "topup": {
      "max_assets": 500,
      "passes": 1,
      "min_relevance": 0.2
    },
    "moments": {
      "enabled": true,
      "min_clip_seconds": 3.0,
      "max_clip_seconds": 20.0,
      "margin_seconds": 1.0,
      "max_moments": 120,
      "regions_per_moment": 3,
      "picks_per_call": 8,
      "frames_per_region": 10,
      "frame_width": 384,
      "trusted_min_approved": 1,
      "accept_fit": [
        "direct",
        "supports"
      ],
      "review_fit": [
        "loose"
      ],
      "min_overlap": 0.5
    },
    "topical": {
      "enabled": true,
      "min_score": 0.5,
      "max_per_moment": 5,
      "moments_per_call": 10
    },
    "general": {
      "enabled": true,
      "max_moments": 40,
      "moments_per_call": 10,
      "queries_per_moment": 2,
      "max_query_chars": 80,
      "photo_width": 640,
      "accept_fit": [
        "direct",
        "supports"
      ],
      "review_fit": [
        "loose"
      ]
    },
    "neighbour_cover": {
      "min_piece_seconds": 3.0,
      "max_hold_seconds": 30.0
    },
    "owner_note": {
      "max_chars": 400
    },
    "timing": {
      "enabled": true,
      "version": 1,
      "assets_per_call": 16,
      "summary_chars": 170,
      "phases": [
        "scene",
        "investigation",
        "interview",
        "arrest_charge",
        "court_filing",
        "trial",
        "verdict",
        "sentencing",
        "aftermath",
        "background"
      ],
      "always_ok": [
        "background"
      ]
    },
    "overlays": {
      "enabled": true,
      "version": 2,
      "frames_per_video": 3,
      "video_frame_width": 960,
      "photo_width": 1280,
      "min_keep_area": 0.4,
      "min_aspect": 0.56,
      "max_aspect": 2.4,
      "frame_preference": 0.75,
      "must_hold_centre": true,
      "margin": 0.012,
      "max_marks": 12,
      "pictures_per_call": 1,
      "kinds": [
        "logo",
        "watermark",
        "caption",
        "channel_name",
        "ticker",
        "bar",
        "credit_line",
        "other"
      ],
      "edges": {
        "enabled": true,
        "edge_seconds": 15.0,
        "frames_per_edge": 6,
        "min_keep_seconds": 3.0
      }
    }
  }
}
