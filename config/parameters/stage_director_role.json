{
  "agents": {
    "host.stage_direction": {
      "role": "host_stage_director",
      "prompt": "documentary/host/stage_director_system_prompt",
      "output": "json",
      "description": "Stage direction of one host appearance from its real audio.",
      "used_by": "app/agents/stage_director.py"
    }
  },
  "generation_providers": {
    "apimaster": {
      "routing": {
        "host_stage_director": "sol"
      }
    }
  },
  "generation": {
    "host_stage_director": {
      "temperature": 0.4,
      "max_tokens": 8000
    }
  }
}
