{
  "story": {
    "default_target_minutes": 50,
    "min_target_minutes": 45,
    "max_target_minutes": 120
  },
  "story_quality": {
    "minimum_grounding_score": 0.85,
    "max_unsupported_claims": 2,
    "max_grounding_repair_iterations": 2,
    "consistency_max_high_severity": 0,
    "disputed_confidence_threshold": 0.7,
    "strip_markdown_artifacts": true,
    "section_marker_prefix": "[[ACT:",
    "max_evidence_per_story": 100,
    "max_evidence_per_act": 100
  },
  "cost_control": {
    "stage_time_budgets": {}
  },
  "research_depth": {
    "minutes_per_fulltext_source": 2.5,
    "minutes_per_partial_source": 1.2,
    "minutes_per_summary_source": 0.35,
    "minutes_per_metadata_source": 0.0,
    "minutes_per_evidence_item": 0.15,
    "minutes_per_human_detail": 0.5,
    "minutes_per_scene_detail": 0.5,
    "minutes_per_investigation_detail": 0.4,
    "minutes_per_quote": 0.3,
    "minutes_per_timeline_event": 0.25,
    "minutes_per_contradiction": 1.0,
    "minutes_per_independent_family": 0.4,
    "max_evidence_item_minutes": 18.0,
    "minimum_capacity_ratio": 0.75,
    "source_readiness_min_ratio": 0.5,
    "min_retrieved_sources": 1,
    "weak_area_minimums": {
      "human_details": 3,
      "scene_details": 3,
      "approved_quotes": 1,
      "investigation_details": 2
    }
  },
  "source_chunking": {
    "target_tokens": 900,
    "min_tokens": 200,
    "max_tokens": 1400,
    "max_chunks_per_source_for_extraction": 4,
    "max_sources_per_extraction_call": 2,
    "extraction_concurrency": 4,
    "merge_min_similarity": 0.9,
    "max_sources_per_case_for_extraction": 50,
    "duplicate_source_min_similarity": 0.92
  },
  "evidence_strength": {
    "weights": {
      "primary": 1.0,
      "strong_secondary": 0.8,
      "secondary": 0.6,
      "tertiary": 0.35,
      "weak": 0.15,
      "disputed": 0.2
    }
  },
  "multilingual": {
    "research_languages": [
      "fa",
      "en",
      "de",
      "ar"
    ],
    "evidence_language": "en",
    "language_catalog": {
      "fa": {
        "name": "Persian",
        "direction": "rtl",
        "brave_search_lang": null,
        "video_search_stems": [
          "{t} مستند پرونده",
          "{t} جنایت",
          "{t} مستند",
          "{t} دادگاه",
          "{t} تاریخچه",
          "{t} پادکست",
          "{t}"
        ],
        "video_query_stem": "{title} مستند پرونده تحقیق"
      },
      "en": {
        "name": "English",
        "brave_search_lang": "en",
        "video_search_stems": [
          "{t} documentary",
          "{t} true crime",
          "{t} full episode",
          "{t} trial",
          "{t} history explained",
          "{t} podcast",
          "{t} news report",
          "{t}"
        ],
        "video_query_stem": "{title} documentary investigation"
      },
      "de": {
        "name": "German",
        "brave_search_lang": "de",
        "video_search_stems": [
          "{t} Doku Fall",
          "{t} Verbrechen",
          "{t} Dokumentation",
          "{t} Prozess",
          "{t} Geschichte",
          "{t} Podcast",
          "{t}"
        ],
        "video_query_stem": "{title} Doku Fall Ermittlungen"
      },
      "ar": {
        "name": "Arabic",
        "direction": "rtl",
        "brave_search_lang": "ar",
        "video_search_stems": [
          "{t} وثائقي قضية",
          "{t} جريمة",
          "{t} وثائقي",
          "{t} محاكمة",
          "{t} تاريخ",
          "{t} بودكاست",
          "{t}"
        ],
        "video_query_stem": "{title} وثائقي قضية تحقيق"
      },
      "ja": {
        "name": "Japanese",
        "brave_search_lang": "ja",
        "video_search_stems": [
          "{t} ドキュメンタリー 事件",
          "{t} 犯罪",
          "{t}"
        ],
        "video_query_stem": "{title} ドキュメンタリー 捜査"
      },
      "zh": {
        "name": "Chinese",
        "brave_search_lang": "zh-hans",
        "video_search_stems": [
          "{t} 纪录片 案件",
          "{t} 犯罪",
          "{t}"
        ],
        "video_query_stem": "{title} 纪录片 调查"
      },
      "fr": {
        "name": "French",
        "brave_search_lang": "fr",
        "video_search_stems": [
          "{t} documentaire affaire",
          "{t} crime",
          "{t}"
        ],
        "video_query_stem": "{title} documentaire enquête"
      },
      "es": {
        "name": "Spanish",
        "brave_search_lang": "es",
        "video_search_stems": [
          "{t} documental caso",
          "{t} crimen",
          "{t}"
        ],
        "video_query_stem": "{title} documental investigación"
      },
      "it": {
        "name": "Italian",
        "brave_search_lang": "it",
        "video_search_stems": [
          "{t} documentario caso",
          "{t} crimine",
          "{t}"
        ],
        "video_query_stem": "{title} documentario indagine"
      }
    },
    "production_languages": [
      "fa",
      "en",
      "de",
      "ar"
    ]
  },
  "language_quality": {
    "fa": {
      "minimum_target_script_ratio": 0.9,
      "max_foreign_token_ratio": 0.03
    },
    "ar": {
      "minimum_target_script_ratio": 0.9,
      "max_foreign_token_ratio": 0.03
    }
  },
  "similarity": {
    "ngram_size": 8,
    "max_ngram_overlap_ratio": 0.02,
    "max_longest_sequence_ratio": 0.05,
    "structure_overlap_threshold": 0.7
  },
  "review_independence": {
    "enabled": true,
    "author_roles": [
      "story_director"
    ],
    "reviewer_roles": [
      "grounding_validator",
      "consistency_checker",
      "semantic_consistency_checker"
    ],
    "groups": [
      {
        "name": "spoken_adaptation",
        "authors": [
          "spoken_writer"
        ],
        "reviewers": [
          "spoken_meaning_checker",
          "spoken_style_critic"
        ],
        "strict": true
      },
      {
        "name": "documentary_production",
        "authors": [
          "visual_director"
        ],
        "reviewers": [
          "automation_feel_critic",
          "attention_critic",
          "visual_accuracy_critic",
          "production_critic",
          "visual_auditor",
          "video_auditor"
        ],
        "strict": true
      },
      {
        "name": "documentary_host",
        "authors": [
          "host_director",
          "host_writer"
        ],
        "reviewers": [
          "host_critic"
        ],
        "strict": true
      },
      {
        "name": "video_pieces",
        "authors": [
          "video_segmenter"
        ],
        "reviewers": [
          "video_auditor"
        ],
        "strict": true
      },
      {
        "name": "documentary_cards",
        "authors": [
          "chapter_writer"
        ],
        "reviewers": [
          "chapter_auditor"
        ],
        "strict": true
      },
      {
        "name": "case_titles",
        "authors": [
          "case_naming_agent"
        ],
        "reviewers": [
          "case_title_critic",
          "native_title_critic"
        ],
        "strict": false
      },
      {
        "name": "research_claims",
        "authors": [
          "fact_extractor"
        ],
        "reviewers": [
          "evidence_verifier"
        ],
        "strict": false
      },
      {
        "name": "visual_planning",
        "authors": [
          "visual_planner"
        ],
        "reviewers": [
          "visual_verifier"
        ],
        "strict": false
      },
      {
        "name": "language_pipeline",
        "authors": [
          "language_draft_writer",
          "language_rewrite_writer",
          "language_final_writer",
          "language_rewrite_writer_fa_ar",
          "language_final_writer_fa_ar"
        ],
        "reviewers": [
          "language_inspector"
        ],
        "strict": true,
        "same_model_allowed": true,
        "owner_decision": "Owner decision 2026-10-17 (docs/story_change_1.txt): the inspector runs on GPT 6.1 Sol, the same model as the rewrite and final writers; its independence is a separate agent with its own prompt and fresh context."
      },
      {
        "name": "english_evidence_audit",
        "authors": [
          "language_draft_writer"
        ],
        "reviewers": [
          "english_evidence_auditor"
        ],
        "strict": true
      }
    ],
    "reviewer_fallbacks": {
      "premium": [
        "writer"
      ],
      "cheap": [],
      "writer": []
    }
  },
  "spoken": {
    "languages": [
      "en",
      "de",
      "fa",
      "ar"
    ],
    "min_duration_ratio": 0.85,
    "max_duration_ratio": 1.3,
    "max_repair_iterations": 2,
    "min_storyteller_share": 0.7,
    "max_sentence_words": {
      "en": 24,
      "de": 20,
      "fa": 24,
      "ar": 22
    },
    "max_long_sentence_share": 0.12
  },
  "opening": {
    "strategies": {
      "critical_moment": "start inside the decisive moment of the case, then step back",
      "mysterious_statement": "start with a documented statement that does not add up",
      "victim_introduction": "start with the person at the centre, their life just before",
      "evidence_discovery": "start with the moment a piece of evidence was found",
      "emergency_call": "start with the call or report that set everything in motion",
      "important_location": "start at the place that holds the story",
      "contradiction": "start with two facts that cannot both be true",
      "last_sighting": "start with the last time the person was seen",
      "courtroom_outcome": "start with the verdict, then ask how it came to this",
      "unanswered_question": "start with the question the case still leaves open",
      "timeline_anomaly": "start with a gap or impossibility in the timeline"
    },
    "follow_up_strategy": "previous_coverage",
    "avoid_recent": 3
  }
}
