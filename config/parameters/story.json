    "minutes_per_partial_source": 1.2,
    "minutes_per_summary_source": 0.35,
    "minutes_per_metadata_source": 0.0,
    "minutes_per_evidence_item": 0.15,
    "minutes_per_human_detail": 0.5,
    "minutes_per_scene_detail": 0.5,
    "minutes_per_investigation_detail": 0.4,
    "minutes_per_quote": 0.3,
    "minutes_per_timeline_event": 0.25,
    "minutes_per_contradiction": 1.0,
    "minutes_per_independent_family": 0.4,
    "max_evidence_item_minutes": 18.0,
    "minimum_capacity_ratio": 0.75,
    "source_readiness_min_ratio": 0.5,
    "min_retrieved_sources": 1,
    "weak_area_minimums": {
      "human_details": 3,
      "scene_details": 3,
      "approved_quotes": 1,
      "investigation_details": 2
    }
  },
  "source_chunking": {
    "target_tokens": 900,
    "min_tokens": 200,
    "max_tokens": 1400,
    "max_chunks_per_source_for_extraction": 4
  },
  "evidence_strength": {
    "weights": {
      "primary": 1.0,
      "strong_secondary": 0.8,
      "secondary": 0.6,
      "tertiary": 0.35,
      "weak": 0.15,
      "disputed": 0.2
    }
  },
  "multilingual": {
    "research_languages": [
      "en",
      "de",
      "fa",
      "ar"
    ],
    "canonical_language": "en",
    "localization_languages": [
      "de",
      "fa",
      "ar"
    ]
  },
  "localization": {
    "require_master_ready": true,
    "words_per_minute": {
      "en": 150,
      "de": 140,
      "fa": 135,
      "ar": 130
    },
    "minimum_native_quality_score": 75,
    "minimum_semantic_consistency_score": 90,
    "minimum_factual_consistency_score": 0.9,
    "minimum_engagement_score": 80,
    "max_localization_repair_iterations": 1,
    "minimum_duration_ratio": 0.8,
    "maximum_duration_ratio": 1.25,
    "require_current_evidence": true
  },
  "language_quality": {
    "fa": {
      "minimum_target_script_ratio": 0.9,
      "max_foreign_token_ratio": 0.03
    },
    "ar": {
      "minimum_target_script_ratio": 0.9,
      "max_foreign_token_ratio": 0.03
    }
  },
  "similarity": {
    "ngram_size": 8,
    "max_ngram_overlap_ratio": 0.02,
    "max_longest_sequence_ratio": 0.05,
    "structure_overlap_threshold": 0.7
  },
  "review_independence": {
