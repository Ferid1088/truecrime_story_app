{
  "story": {
    "default_target_minutes": 50,
    "min_target_minutes": 45,
    "max_target_minutes": 120,
    "words_per_minute": 135,
    "minimum_length_ratio": 0.85,
    "maximum_length_ratio": 1.15,
    "max_rewrite_iterations": 3,
    "max_length_repair_iterations": 2,
    "engagement_threshold": 85
  },
  "story_quality": {
    "minimum_grounding_score": 0.85,
    "max_unsupported_claims": 2,
    "max_grounding_repair_iterations": 2,
    "section_engagement_threshold": 55,
    "max_section_rewrites": 2,
    "consistency_max_high_severity": 0,
    "disputed_confidence_threshold": 0.7,
    "strip_markdown_artifacts": true,
    "section_marker_prefix": "[[ACT:"
  },
  "master_generation": {
    "section_based_generation": true,
    "section_word_tolerance": 0.25,
    "rewrite_length_tolerance": 0.15,
    "max_sections_per_revision_cycle": 2,
    "max_revision_cycles": 2,
    "minimum_engagement_improvement": 5,
    "min_act_budget_share": 0.08,
    "max_span_repairs_per_pass": 12
  },
  "cost_control": {
    "max_master_tokens_per_case": 1500000,
    "max_master_cost_usd": 1.5
  },
  "research_depth": {
