{
  "providers": {
    "research": "truecrime",
    "generation": "apimaster"
  },
  "research_providers": {
    "truecrime": {
      "enabled": true,
      "type": "search_engine",
      "role": "internet_research"
    }
  },
  "generation_providers": {
    "apimaster": {
      "enabled": true,
      "base_url": "https://apimaster.ai/v1",
      "secret_env": "TRUECRIME_APIMASTER_API_KEY",
      "inactivity_timeout_s": 900
    }
  },
  "search_engine": {
    "brave_api_key_env": "BRAVE_SEARCH_API_KEY",
    "brave_base_url": "https://api.search.brave.com",
    "request_timeout_s": 10,
    "search_min_interval_s": 1.0,
    "health_cache_seconds": 600,
    "max_results_per_query": 10,
    "max_queries_per_language": 6,
    "max_rounds_per_language": 3,
    "max_fetches_per_language": 10,
    "consecutive_low_novelty_stop": 2,
    "max_duration_s": 900,
    "min_accept_score": 0.2,
    "fetch_quality_floor": 0.15,
    "rerank_band_low": 0.35,
    "rerank_band_high": 0.6,
    "max_rerank_candidates": 10,
    "enable_llm_rerank": true,
    "enable_gap_analysis": true,
    "min_full_text_chars": 1200,
    "fetch_timeout_s": 30,
    "fetch_max_bytes": 8000000,
    "fetch_cache_max_age_s": 604800,
    "fetch_resolve_dns": true,
    "min_delay_per_domain_s": 1.0,
    "max_fetch_concurrency": 4,
    "primary_source_queries": {
      "enabled": true,
      "languages": ["en"],
      "extra_fetches": 6,
      "templates": [
        {"query": "{case} court records indictment", "purpose": "court_record"},
        {"query": "{case} court docket case file", "purpose": "court_record"},
        {"query": "{case} search warrant affidavit", "purpose": "court_record"},
        {"query": "{case} sentencing hearing court document", "purpose": "court_record"},
        {"query": "{case} police press release statement", "purpose": "police"},
        {"query": "{case} prosecutor statement press release", "purpose": "official_record"},
        {"query": "{case} official report investigation findings", "purpose": "official_record"},
        {"query": "{case} coroner autopsy report", "purpose": "coroner"},
        {"query": "{place} police department press release {case}", "purpose": "police"},
        {"query": "{place} prosecutor office statement {case}", "purpose": "official_record"}
      ]
    },
    "bm25_weight": 0.55,
    "dense_weight": 0.45
  },
  "avatar": {
    "provider": "heygen",
    "secret_env": "TRUECRIME_HEYGEN_API_KEY",
    "avatar_id_env": "TRUECRIME_AVATAR_ID_HEYGEN",
    "enabled": true,
    "base_url": "https://api.heygen.com",
    "output_format": "webm",
    "resolution": "1080p",
    "request_timeout_s": 120.0,
    "poll_interval_s": 10.0,
    "max_poll_minutes": 20.0,
    "fit": "contain",
    "engine": null
  },
  "generation_failover": {
    "enabled": true,
    "name": "apiko",
    "label": "Apiko",
    "base_url": "https://api.apiko.app/v1",
    "secret_env": "TRUECRIME_APICO",
    "inactivity_timeout_s": 900,
    "cooldown_s": 300,
    "secondary_share": 0.5,
    "on": [
      "unreachable",
      "timeout",
      "provider_error",
      "model_unavailable",
      "rate_limited",
      "unauthorized",
      "quota"
    ],
    "quota_http_status": [
      402
    ],
    "quota_messages": [
      "insufficient balance",
      "unpaid billing settlement"
    ],
    "models": {}
  }
}
