# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment secrets
.env
.env.local

# Local database (generated runtime state)
truecrime.db
*.db-journal
truecrime.db*

# Database backups — a full data dump must never land in the repo (a bug in
# the backup destination default, or a run with no configured dir, would
# otherwise write one straight into the repo root).
*.dump

# Rendered documentary media (audio/video per case) — regenerable, large
data/cases/
data/music_library/
Claude outputs/
data/map_cache/
data/fetch_cache/
data/benchmarks/

# hand-over folder for live runs between the app and Claude
tc_transfer/
.tc_live/

# macOS folder metadata
.DS_Store

# studio previews (generated from data/studio, keyed by image hash)
data/studio_thumbs/

# regenerable caches
data/embedding_cache/

# Generated longform verification traces
reports/longform_gates/phase_15_trace*/

# channel intro renders (regenerated from the logo + concept fingerprint)
data/intros/

# generated/archival media (not source; ~290 MB). Back these up with your normal backups, not git.
data/outfits/
data/studio_archive/
data/intro_previews/
backups/
data/backups/

# Native local service runtime state (PIDs, ports, and logs)
data/dev/

# Disposable browser-E2E stack output (logs, seeded fixtures) — never source
data/e2e/
data/e2e-*.log
data/e2e-*/
data/live-*.log

# Live-run hygiene/verification evidence (ffprobe output, frames, screenshots)
data/evidence/

# live-run browser helpers
frontend/.live-run-*.mjs

# live UI proof screenshots (never committed)
data/ui_proof/

# audio takes of the host/voice loop runs (large, regenerable)
reports/host_loop/**/*_takes/
