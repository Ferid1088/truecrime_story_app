# The app default is local PostgreSQL; use sqlite:///./truecrime.db explicitly for unit tests.
TRUECRIME_DATABASE_URL=postgresql+psycopg://truecrime@127.0.0.1:5432/truecrime
# APIMaster — all LLM intelligence (generation/extraction/critique/embeddings)
TRUECRIME_APIMASTER_API_KEY=
# Brave Search Web API (the only web-search provider)
BRAVE_SEARCH_API_KEY=
TRUECRIME_YOUTUBE_API_KEY=
# Archive APIs (P12) — each needs its own free key; a provider is skipped cleanly without one.
TRUECRIME_EUROPEANA_API_KEY=
TRUECRIME_DPLA_API_KEY=
# Documentary voice (text-to-speech) — ElevenLabs
TRUECRIME_ELEVENLABS_API_KEY=

# Host provider (avatar generation is disabled by default).
TRUECRIME_HEYGEN_API_KEY=
TRUECRIME_AVATAR_ID_HEYGEN=

# --- Security (see docs/security.md) ---
# Set a long random value to require sign-in:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the API only answers requests from this machine (loopback).
TRUECRIME_ACCESS_TOKEN=
# Set true when the site is served over HTTPS so the session cookie is Secure.
TRUECRIME_COOKIE_SECURE=false
# Browser origins allowed to call the API (comma separated). Leave unset to derive this
# from TRUECRIME_FRONTEND_PORT below.
TRUECRIME_CORS_ORIGINS=
TRUECRIME_SESSION_DAYS=14

# Local dev process ports (scripts/dev_up.sh, dev_down.sh). The API port is fixed; if the
# frontend port is taken, dev_up.sh moves to the next free one and reports it.
TRUECRIME_API_PORT=8001
TRUECRIME_FRONTEND_PORT=3001

TRUECRIME_JOB_RUNNER=inline
TRUECRIME_LOG_LEVEL=INFO
TRUECRIME_LOG_FORMAT=text
TRUECRIME_PROVIDER_LEDGER=true
TRUECRIME_PROVIDER_LEDGER_DAYS=90

# Frontend API origin (used by frontend/.env.local when it differs from the default;
# dev_up.sh sets NEXT_PUBLIC_API_BASE_URL itself from TRUECRIME_API_PORT).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
