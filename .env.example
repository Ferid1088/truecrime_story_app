DATABASE_URL=sqlite:///./truecrime.db
# APIMaster — all LLM intelligence (generation/extraction/critique/embeddings)
TrueCrime_APIMASTER_API_KEY=
# TrueCrime Search Engine — self-hosted SearXNG backend (compose: :8085)
TRUECRIME_SEARXNG_URL=http://localhost:8085
YOUTUBE_API_KEY=
# Documentary voice (text-to-speech) — ElevenLabs
TrueCrime_ELEVENLABS_API_KEY=

# --- Security (see docs/security.md) ---
# Set a long random value to require sign-in:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the API only answers requests from this machine (loopback).
ACCESS_TOKEN=
# Set true when the site is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Docker compose (docs/deploy.md) ---
POSTGRES_PASSWORD=
# Address the BROWSER uses to reach the API (compiled into the web image).
PUBLIC_API_URL=http://127.0.0.1:8000
# Set to requirements.txt for a lean image without the voice-QA extras (torch, whisper).
PY_REQUIREMENTS=requirements-documentary.txt
SEARXNG_SECRET=
# Docker only: host folder that appears as /backups in the app (set the backup folder in the UI to /backups).
BACKUP_DIR=./backups
